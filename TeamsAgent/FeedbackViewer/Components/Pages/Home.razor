@page "/"

<PageTitle>Home - FeedbackViewer</PageTitle>

<div class="home-container">
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                <i class="bi bi-graph-up-arrow hero-icon"></i>
                Feedback Viewer
            </h1>
            <p class="hero-subtitle">
                Monitor and analyze user feedback in real-time
            </p>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">
                <i class="bi bi-chat-dots"></i>
            </div>
            <h3>Real-time Updates</h3>
            <p>View feedback as it comes in from your users with live updates.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <i class="bi bi-graph-up"></i>
            </div>
            <h3>Easy Analysis</h3>
            <p>Organize and analyze feedback in a clean, table-based interface.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <i class="bi bi-lightning-charge"></i>
            </div>
            <h3>Quick Access</h3>
            <p>Navigate seamlessly between feedback entries and insights.</p>
        </div>
    </div>

    <div class="cta-section">
        <h2>Ready to explore?</h2>
        <p>Start viewing your collected feedback now</p>
        <a href="feedback" class="cta-button">
            <i class="bi bi-eye cta-icon"></i>
            View Feedback
        </a>
    </div>
</div>
